<%- include("./includes/head") %>
  <div class="main">
    <h1 class="title">Posts</h1>
  <div class="post-grid">
    <% for(let post of postsArr) { %>
    <div class="post-box">
      <div>
        <a href="/post/<%= post._id %>">
        <p class="post-title"><%= post.title %></p>
        <img src="<%= post.imageUrl %>" alt="<%= post.title %>" class="post-img"/>
        <p class="post-description"><%= post.description.substring(0,50) %><span>...</span>
        </p>
        <% if(post.userId._id.toString() == currentUserId.toString()) { %>
        <a href="/admin/profile" class="post-link"><span><i class="fa-solid fa-user"></i></span><%= post.userId.username ? post.userId.username : post.userId.email%></a>
         </a>        
        <% }else { %>
        <a href="/profile/<%= post.userId._id %>" class="post-link"><span><i class="fa-solid fa-user"></i></span><%= post.userId.username ? post.userId.username : post.userId.email%></a>
         </a>
        <% } %>
      </div>
    </div>
    <% } %> 
  </div>
  <div class="pagination">
  <% if (hasPreviousPage) { %>
       <a href="/?page=<%= previousPage %>" class="custom-button2 previous">Previous Page <%= previousPage %></a>
    <% } %>
    <% if (hasNextPage) { %>
      <a href="/?page=<%= nextPage %>" class="custom-button next">Next Page <%= nextPage %></a>
    <% } %>
  </div>
  </div>
    <%- include("./includes/foot") %>