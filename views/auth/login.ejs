
<%- include("../includes/head") %>
   <section class="account">
      <h1 class="title">Welcome Back!</h1>
     <% if(message.length) {%>
      <p class="error"><%= message %></p>
      <% }%>
      <form action="/login" method="post">
         <input hidden value="<%= csrfToken %>" name="_csrf"/>
        <div class="account-email">
          <label for="email">Enter Email</label>
          <input type="text" id="email" name="email" value="<%= oldFromData.email %>" />
        </div>
        <div class="account-password">
          <label for="password">Enter password</label>
          <input type="text" id="password" name="password" value="<%= oldFromData.password %>" />
        </div>
        <div class="account-action">
        <a href="/reset-password" class="custom-button2">Forgot password?</a>
        <button class="custom-button">Login Account</button>
        </div>
      </form>
    </section>
  </body>
  <%- include("../includes/foot") %>