<%- include("./includes/head") %>
    <section class="add">
      <h1>Add a new post here!</h1>
    <% if(message.length) {%>
      <p class="error"><%= message %></p>
      <% }%>
      <form action="/admin" method="post" enctype="multipart/form-data">
         <input hidden value="<%= csrfToken %>" name="_csrf"/>
        <div class="add-title">
          <label for="title">Enter title</label>
          <input type="text" id="title" name="title" value="<%= oldFromData.title %>"/>
        </div>
        <div class="add-img">
          <label for="photo">Enter photo</label>
          <input type="file" id="photo" name="photo"/>
        </div>
        <div class="add-description">
          <label for="description">Enter description</label>
          <textarea
            name="description"
            id="description"
            cols="30"
            rows="10"
           
          ><%= oldFromData.description %></textarea>
        </div>
        <button class="custom-button">Add Post</button>
      </form>
    </section>
  </body>
  <%- include("./includes/foot") %>